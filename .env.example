# WebSocket Server Configuration
WS_HOST=127.0.0.1
WS_PORT=18800
WS_PATH=/ws

# Client Configuration
SENDER_ID=test_user_001
SENDER_NAME=TestUser

# Auth Token (required if auth.enabled=true on server)
WS_TOKEN=your_jwt_token_here

# Bark Push Configuration (iOS notification)
BARK_DEVICE_KEY=your_bark_device_key_here

# WeFlow Monitor Configuration (微信消息 SSE 流)
WEFLOW_HOST=localhost
WEFLOW_PORT=5031
WEFLOW_TOKEN=your_jwt_token_here

# Monitor specific chats (comma-separated sessionId or sessionName)
# Leave empty to monitor all chats
# Example: WX_MONITOR_CHATS=gh_7fbf45a6a562,第一财经
WX_MONITOR_CHATS=

# Trigger thresholds
WX_CONTENT_THRESHOLD=1000
WX_MESSAGE_THRESHOLD=10
WX_IDLE_TIMEOUT=20

# Template file path for message formatting
WX_TEMPLATE=templates/wx_template_example.j2
