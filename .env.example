# Connector supervisor / mounted connector settings
# Copy this file to .env before running Docker Compose.

# Used by connectors/my-source/connector.yaml
GITHUB_REPOSITORY=drtx32/PulseRelay

# Optional: private repositories or higher GitHub API limits.
GITHUB_TOKEN=

# GBrain HTTP MCP connector (enable connectors/gbrain/connector.yaml after configuring)
GBRAIN_MCP_URL=https://gbrain-mcp.tong-xiao.top/mcp
# Use either a static token, or OAuth client credentials below.
GBRAIN_MCP_TOKEN=
GBRAIN_CLIENT_ID=
GBRAIN_CLIENT_SECRET=
GBRAIN_OAUTH_TOKEN_URL=https://gbrain-mcp.tong-xiao.top/token
GBRAIN_OAUTH_SCOPE=read
GBRAIN_LIST_RUNS_TOOL=list_pages
GBRAIN_GET_OUTPUT_TOOL=get_page
GBRAIN_LIST_RUNS_ARGS_JSON={"type":"task_run","sort":"updated_asc","limit":100}
GBRAIN_GET_OUTPUT_ARGS_JSON={}
GBRAIN_POLL_INTERVAL_SECONDS=60

# PulseRelay bootstrap/admin bearer used by the Web UI and MCP credential
# management endpoints. Normal remote MCP clients should use an API key or an
# OAuth access token created from the Web UI/API instead of sharing this token.
PULSERELAY_ADMIN_TOKEN=

# PulseRelay MCP is served by the main process at http(s)://<host>:8000/mcp.
# API keys and OAuth clients/access tokens are persisted in the PulseRelay DB.
# OAuth client_credentials token endpoint: /oauth/token (compat alias: /token).
# Supported OAuth presets: read, write, admin; fine-grained scopes are also
# available from GET /v1/mcp/scopes.
PULSERELAY_MCP_HOST=0.0.0.0

# Optional legacy/server-side GBrain admin bridge. PulseRelay-native MCP key and
# OAuth management no longer depends on these values.
GBRAIN_ADMIN_URL=http://gbrain:8088
GBRAIN_ADMIN_BOOTSTRAP_TOKEN=

# Multica Automation completion connector (connectors/multica/connector.yaml)
# Use a Multica API key/service token with permission to read autopilot runs.
MULTICA_API_URL=https://multica.ai
MULTICA_API_TOKEN=
# Comma-separated autopilot IDs to monitor. Leave empty until configured.
MULTICA_AUTOPILOT_IDS=
# Optional endpoint override; {autopilot_id} is replaced at runtime.
MULTICA_AUTOPILOT_RUNS_URL=
