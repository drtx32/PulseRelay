# PulseRelay now stores runtime settings in JSON.
# Copy data/pulserelay.json to a private path if you need real tokens, then point to it here.
PULSERELAY_CONFIG=data/pulserelay.json

# Legacy environment variables are still accepted as overrides for existing deployments:
# WS_HOST=127.0.0.1
# WS_PORT=18800
# WS_PATH=/ws
# SENDER_ID=test_user_001
# SENDER_NAME=TestUser
# WS_TOKEN=your_jwt_token_here
# BARK_DEVICE_KEY=your_bark_device_key_here
# WEFLOW_HOST=localhost
# WEFLOW_PORT=5031
# WEFLOW_TOKEN=your_weflow_token_here
# MONITOR_CHATS=gh_7fbf45a6a562,第一财经
# CONTENT_THRESHOLD=1000
# MESSAGE_THRESHOLD=10
# IDLE_TIMEOUT=20
# MIN_TRIGGER_INTERVAL=5.0
# MESSAGE_TEMPLATE=templates/message_summary_example.j2
# LARK_ENABLED=false
# LARK_VERIFICATION_TOKEN=your_lark_verification_token_here
# LARK_ENCRYPT_KEY=reserved_for_future_encrypted_callbacks
# LARK_CALLBACK_PATH=/sources/lark/events
